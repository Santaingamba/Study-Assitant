{
  "name": "study_assistant",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm run build --prefix client",
    "start:prod": "node server/index.js",
    "postinstall": "npm --prefix client install --include=dev",
    "test": "vitest run"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
